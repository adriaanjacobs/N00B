#pragma once

// the address-ignore feature the tag layout below was configured for, see noobconfig.cmake
#define NOOB_TAG_SCHEME             "@NOOB_TAG_SCHEME@"

/**
 * The number of bits in the toptag.
 */
#define TAG_WIDTH                   (${TAG_WIDTH})
#define NOOB_TOPTAG_START           (${NOOB_TOPTAG_START})
static_assert(NOOB_TOPTAG_START + TAG_WIDTH <= 64);

/**
 * The smallest size for N00B-managed objects.
 * For example if this is 4, the smallest objects can be 16 bytes.
 * Smaller objects are automatically increased to this size.
 */
#define NOOB_MIN_POWER              (${NOOB_MIN_POWER})

/**
 * Power of objects that N00B no longer manages.
 * The space N00B would normally use for these objects can be safely used for data that shouldn't be
 * managed by N00B.
 */
#define NON_NOOB_MIN_POWER          (${NON_NOOB_MIN_POWER})
#cmakedefine01 NOOB_IGNORE_ERRORS
#cmakedefine01 NOOB_TAG_POINTERS
#define NOOB_MAX_ADDR               (${NOOB_MAX_ADDR})

#define NOOB_STACK_SIZE             (${NOOB_STACK_SIZE})

#cmakedefine01 CHECK_DEREFERENCE_SITES
#cmakedefine01 CHECK_ESCAPE_SITES
#cmakedefine01 CHECK_POINTER_ARITHMETIC
#cmakedefine01 CHECK_POINTER_DEREFERENCES
#cmakedefine01 USE_BRANCHING_CHECKS
#cmakedefine01 INTRAPROCEDURAL_ONLY
#cmakedefine01 SOUND_POINTER_DETECTION

#cmakedefine01 MASK_EXT_PTR_ARGS
#cmakedefine01 COUNT_NOOB_FAILURES

#cmakedefine01 REPLACE_STACK_ALLOCS
#cmakedefine01 REMAP_GLOBALS

#cmakedefine01 EMIT_RUNTIME_CALLS

#cmakedefine01 EMULATE_LOWFAT

/**
 * Extra padding that should be added to each allocation using the N00B allocator. Useful for
 * testing.
 */
#define NOOBALLOC_PADDING_BYTES     ${NOOBALLOC_PADDING_BYTES}

/**
 * Log allocation metrics when threads finish or the allocator is unloaded. Enabling this only turns
 * on metric collection. Logging needs to be on to actually show them.
 */
#define NOOBALLOC_METRICS           ${NOOBALLOC_METRICS}

/**
 * Whether logging should be included. Logging may still need to be enabled at runtime to actually
 * show any messages.
 */
#define DO_LOGGING                  ${DO_LOGGING}

/**
 * Whether tracing of function calls should be included.
 */
#define DO_TRACING                  ${DO_TRACING}
